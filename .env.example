# Postgres — source of truth. (Compose overrides host with the service name "postgres".)
DATABASE_URL="postgresql://syncin:syncin@localhost:5432/syncin?schema=public"

# Redis — BullMQ broker. Wired up in Milestone 2.
REDIS_URL="redis://localhost:6379"

# HTTP
PORT=3000
HOST=0.0.0.0

# Message provider: "mock" (default, drives all benchmarks) | "twilio" (Milestone 7 adapter)
PROVIDER=mock

# Logging: info | debug | warn | error
LOG_LEVEL=info
